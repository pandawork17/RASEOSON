# ==========================================
# BASEOSON 공용 백엔드 환경 설정 샘플 (.env.example)
# ==========================================

# 1. 데이터베이스 설정 (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shopdb3jo
DB_PASSWORD=shopdb3jo
DB_NAME=shopdb3jo

# 2. JWT 시크릿 키
JWT_SECRET=shopdb3jo-common-backend-secret-key-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 3. CORS 허용 도메인
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

