# ==========================================
# BASEOSON 최종 제출용 .gitignore
# ==========================================

# 1. Node.js & 프론트엔드
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 2. Python & 백엔드 가상환경
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# 3. OS 및 IDE 설정
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

